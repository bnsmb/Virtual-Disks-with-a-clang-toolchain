prefix=/system/usr
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include
supported_protocols="DICT FILE FTP FTPS GOPHER GOPHERS HTTP HTTPS IMAP IMAPS IPFS IPNS MQTT POP3 POP3S RTSP SCP SFTP SMB SMBS SMTP SMTPS TELNET TFTP WS WSS"
supported_features="alt-svc AsynchDNS brotli CAcert HSTS HTTP2 HTTPS-proxy IDN IPv6 Largefile libz NTLM PSL SSL threadsafe TLS-SRP UnixSockets zstd"

Name: libcurl
URL: https://curl.se/
Description: Library to transfer files with HTTP, FTP, etc.
Version: 8.17.0
Requires: 
Requires.private: libidn2,zlib,libbrotlidec,libbrotlicommon,libzstd,openssl,libpsl,libssh2,libnghttp2
Libs: -L${libdir} -lcurl 
Libs.private: -L/data/local/tmp/sysroot/usr/lib -L/data/local/tmp/sysroot/usr/ndk/r27d/sysroot/usr/lib/aarch64-linux-android/31 -L/data/local/tmp/sysroot/usr/ndk/r27d/sysroot/usr/lib/aarch64-linux-android -L/data/local/tmp/develop/sysroot/usr/lib -L/data/local/tmp/develop/sysroot/usr/lib -L/data/local/tmp/develop/sysroot/usr/lib -L/data/local/tmp/sysroot/usr/lib -L/data/local/tmp/develop/sysroot/usr/lib -L/data/local/tmp/sysroot/usr/lib -L/data/local/tmp/sysroot/lib -lnghttp2 -lidn2 -lssh2 -lssh2 -lpsl -lssl -lcrypto -lssl -lcrypto -lzstd -lzstd -lbrotlidec -lbrotlidec -lbrotlicommon -lz -lidn2 -lunistring -ldl -lm
Cflags: -I${includedir} 
Cflags.private: -DCURL_STATICLIB
